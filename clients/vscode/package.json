{
  "name": "lis-vscode",
  "displayName": "Lis",
  "description": "Personal AI assistant — chat with Lis from inside VS Code.",
  "version": "0.1.0",
  "publisher": "lis",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "browser": "./dist/extension.js",
  "main": "./dist/extension.js",
  "icon": "media/lis-avatar.png",
  "activationEvents": [
    "onView:lis.sessions"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lis-sidebar",
          "title": "Lis",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "lis-sidebar": [
        {
          "id": "lis.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "lis.connect",
        "title": "Lis: Connect"
      },
      {
        "command": "lis.disconnect",
        "title": "Lis: Disconnect"
      },
      {
        "command": "lis.newChat",
        "title": "Lis: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "lis.refreshSessions",
        "title": "Lis: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "lis.openChat",
        "title": "Lis: Open Chat"
      },
      {
        "command": "lis.showOutput",
        "title": "Lis: Show Output"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lis.newChat",
          "when": "view == lis.sessions",
          "group": "navigation@1"
        },
        {
          "command": "lis.refreshSessions",
          "when": "view == lis.sessions",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Lis",
      "properties": {
        "lis.serverUrl": {
          "type": "string",
          "default": "ws://localhost:3010/web/ws",
          "description": "WebSocket URL of the Lis server."
        },
        "lis.authToken": {
          "type": "string",
          "default": "",
          "description": "Shared secret matching WEB_CHANNEL_TOKEN on the server."
        },
        "lis.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log every WebSocket frame sent and received to the Lis output channel. Noisy; use for protocol debugging."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@preact/signals": "^2.9.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4",
    "preact": "^10.29.2"
  }
}
