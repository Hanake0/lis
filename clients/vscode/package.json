{
  "name": "lis-vscode",
  "displayName": "Lis",
  "description": "Personal AI assistant — chat with Lis from inside VS Code.",
  "version": "0.1.0",
  "publisher": "lis",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "browser": "./dist/extension.js",
  "main": "./dist/extension.js",
  "icon": "media/lis-avatar.png",
  "activationEvents": [
    "onView:lis.sidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lis-sidebar",
          "title": "Lis",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "lis-sidebar": [
        {
          "id": "lis.sidebar",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "lis.connect",
        "title": "Lis: Connect"
      },
      {
        "command": "lis.disconnect",
        "title": "Lis: Disconnect"
      },
      {
        "command": "lis.newChat",
        "title": "Lis: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "lis.openChat",
        "title": "Lis: Open Chat"
      },
      {
        "command": "lis.showOutput",
        "title": "Lis: Show Output"
      },
      {
        "command": "lis.configure",
        "title": "Lis: Configure"
      }
    ],
    "configuration": {
      "title": "Lis",
      "properties": {
        "lis.serverUrl": {
          "type": "string",
          "default": "http://localhost:3010",
          "description": "Base origin of the Lis server (e.g. http://localhost:3010 or https://lis.example.com). The extension derives REST, SSE, and (legacy) WebSocket URLs from this. Old ws://…/web/ws values are auto-migrated."
        },
        "lis.authToken": {
          "type": "string",
          "default": "",
          "description": "Shared secret matching WEB_CHANNEL_TOKEN on the server."
        },
        "lis.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log every WebSocket frame sent and received to the Lis output channel. Noisy; use for protocol debugging."
        }
      }
    }
  },
  "scripts": {
    "build": "tailwindcss -i src/webview/styles.css -o dist/chat.css && node esbuild.mjs",
    "watch": "concurrently \"tailwindcss -i src/webview/styles.css -o dist/chat.css --watch\" \"node esbuild.mjs --watch\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/**/*.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.100.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@remixicon/react": "^4.0.0",
    "@tanstack/react-virtual": "^3.13.25",
    "@types/prismjs": "^1.26.6",
    "@types/qrcode": "^1.5.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.3.0",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "marked": "^18.0.4",
    "motion": "^12.0.0",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remend": "^1.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.0"
  }
}
